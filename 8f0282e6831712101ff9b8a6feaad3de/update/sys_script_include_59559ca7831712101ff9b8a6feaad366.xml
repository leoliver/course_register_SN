        <script><![CDATA[var ValidateTrainingSchedule = Class.create();
ValidateTrainingSchedule.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	validateSchedule: function() {
		var course = this.getParameter("sysparm_course");
        var date = this.getParameter("sysparm_date");

		var gr = new GlideRecord('x_1593179_traini_0_schedule');
		gr.addQuery("course", course);
		gr.addQuery("date", date);
        gr.setLimit(1);
        gr.query();
        
        if (gr.next()) {
            return 'true';
        }
        return 'false';
	},

    type: 'ValidateTrainingSchedule'
});]]></script>

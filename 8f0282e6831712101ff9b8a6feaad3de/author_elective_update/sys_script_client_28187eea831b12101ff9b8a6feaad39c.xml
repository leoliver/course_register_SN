        <field/>
        <global>true</global>
        <isolate_script>true</isolate_script>
        <messages/>
        <name>Validate Course and Date</name>
        <order/>
        <script><![CDATA[function onSubmit() {
	var date = g_form.getValue("date").split("/");
	date = date[2] + "-" + date[1] + "-" + date[0];
	var course = g_form.getValue("course");

	var ga = new GlideAjax('global.glideAjaxScheduleValidation');
    ga.addParam('sysparm_name', 'validateSchedule');
    ga.addParam('sysparm_course', course.toString());
    ga.addParam('sysparm_date', date.toString());

    var isDuplicate = false;

    ga.getXMLAnswer(function(response) {
        isDuplicate = response === 'true';
    });

    if (isDuplicate) {
        g_form.addErrorMessage('There is already a schedule for this date and course');
        return false;
    }
    return true;
	
}]]></script>

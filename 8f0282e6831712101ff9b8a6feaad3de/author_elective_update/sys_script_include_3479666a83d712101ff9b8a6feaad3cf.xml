        <script><![CDATA[var ScheduleValidation = Class.create();
ScheduleValidation.prototype = {
    initialize: function () {},

    validateSchedule: function(course, date) {
        var grCourse = new GlideRecord('x_1593179_traini_0_schedule');
        grCourse.addQuery('course.sys_id', course);
        grCourse.addQuery('date', date);
        grCourse.setLimit(1);
        grCourse.query();
        
        if (grCourse.next()) {
            return true;
        }
        return false;
    },

    type: 'ScheduleValidation'
};]]></script>
